{
  "name": "epe-lawa",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.9",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "tsx --conditions=react-server --test frontend/tests/*.test.mjs backend/tests/*.test.mjs && vitest run",
    "test:browser-smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:browser-smoke-push": "playwright test --config=playwright.smoke-push.config.ts",
    "audit": "node scripts/audit/run.mjs",
    "audit:security": "node scripts/audit/run.mjs --only=hacking",
    "audit:ui": "node scripts/audit/run.mjs --only=ui",
    "audit:ci": "node scripts/audit/run.mjs --fail-on=medium",
    "ux:audit": "node scripts/ux-audit.mjs",
    "test:node": "tsx --conditions=react-server --test frontend/tests/*.test.mjs backend/tests/*.test.mjs",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23"
  }
}
