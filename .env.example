# EPE LAWA — environment variables
# Copy this file to .env.local (development) and set the real values in Vercel (production).
# Never commit real values. Names marked **never** must never reach a client bundle.
# Every name referenced in source is listed here. Angle-bracket values are placeholders.
# Feature flags that must stay off until verified are commented out.

# ── Site origin ─────────────────────────────────────────────────────────────
# Canonical origin of the platform. Used for metadataBase, canonical URLs, sitemap,
# Open Graph and CORS. Fallback in code: https://epelawa.vercel.app
NEXT_PUBLIC_SITE_URL=https://epelawa.vercel.app

# News and staff use this same origin at /news and /admin; no separate host variables are needed.

# ── Database / direct SQL (server only) ──────────────────────────────────────
# Used by backend schema-audit and migration tooling. Never in a client bundle,
# a log or a test fixture.
DATABASE_URL=<never — set in Vercel>

# ── Supabase ────────────────────────────────────────────────────────────────
# Public: safe to ship to the browser. RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://igqmybuiovaxqmrteebd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<never — set in Vercel>

# Server only. Never in a client bundle, a log or a test fixture.
SUPABASE_SERVICE_ROLE_KEY=<never — set in Vercel>

# NEEDS OWNER DECISION (checklist item 339): the codebase also references the
# newer Supabase names below. Do not set two naming schemes at once. Record the
# chosen scheme here once the owner/tech-lead decides. Placeholders only.
# SUPABASE_URL=<set in Vercel>
# SUPABASE_PUBLISHABLE_KEY=<set in Vercel>
# SUPABASE_ANON_KEY=<set in Vercel>

# ── Cloudflare R2 (object storage) ──────────────────────────────────────────
# Media rows store provider + bucket + object_key, never a full URL.
R2_BUCKET_PUBLIC=<set in Vercel>
R2_BUCKET_PRIVATE=<set in Vercel>
R2_ACCOUNT_ID=<set in Vercel>
# Public base URL used to build media URLs in the browser. No secret in it.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=<set in Vercel>

# ── Database backup workspace (server only — never NEXT_PUBLIC_) ───────────
# CLOUDFLARE_API_TOKEN: scoped to R2 object LIST on the private bucket. Used by
# the admin server component to list backup metadata. Never sent to browser.
CLOUDFLARE_API_TOKEN=<never — set in Vercel, server only>
# BACKUP_DISPATCH_TOKEN: GitHub token with `actions:write` on the repo below.
# BACKUP_WORKFLOW_REPO: owner/repo that hosts db-backup.yml + db-restore.yml.
# BACKUP_WORKFLOW_REF: branch to dispatch (defaults to main if omitted).
BACKUP_DISPATCH_TOKEN=<never — set in Vercel, server only>
BACKUP_WORKFLOW_REPO=<set in Vercel, server only>
BACKUP_WORKFLOW_REF=main

# GitHub Actions secrets (NOT in Vercel — these live in the workflow only):
#   DATABASE_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#   R2_ACCOUNT_ID, R2_BUCKET_PRIVATE
# The Next.js server and browser never receive DATABASE_URL or R2 write keys.

# ── Custom Auth email (server only) ─────────────────────────────────────────
# Server only.
RESEND_API_KEY=<never — set in Vercel>
# Custom Supabase Auth email hook, server-only. Do not enable the hook until
# the deployed route, sender domain, secret and end-to-end delivery are verified.
# Gmail takes precedence if both Gmail values are set. If neither is set,
# Resend is used when its key is configured. Partial Gmail config fails closed.
AUTH_GMAIL_USER=<Gmail account — set in Vercel>
AUTH_GMAIL_APP_PASSWORD=<Gmail app password — set in Vercel, never in chat>
# Optional defaults: Gmail only, 465 implicit TLS or 587 required STARTTLS.
AUTH_GMAIL_SMTP_HOST=smtp.gmail.com
AUTH_GMAIL_SMTP_PORT=465
AUTH_EMAIL_FROM=<approved sender for selected provider — set in Vercel>
AUTH_EMAIL_HOOK_SECRET=<whsec_ followed by base64 of 32 random bytes; match Supabase — set in Vercel>

# ── Paystack (payments, NGN) ────────────────────────────────────────────────
# Secret key and webhook secret: server only, never in a client bundle.
PAYSTACK_SECRET_KEY=<never — set in Vercel>
PAYSTACK_WEBHOOK_SECRET=<never — set in Vercel>

# Public key: safe for the client (Paystack inline checkout initialisation).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<set in Vercel>

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Single canonical public name — this is the exact var read by
# frontend/apps/main/lib/vapid.ts (`NEXT_PUBLIC_VAPID_PUBLIC_KEY`). Public half
# only; safe for the client. Any server-side private key stays in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<set in Vercel>
NEXT_PUBLIC_WEB_PUSH_ENABLED=<true|false — set in Vercel>

# ── Radio ───────────────────────────────────────────────────────────────────
# Verified direct stream URL for Radio Lagos 107.5 FM (Naija Radio API catalogue).
# Server only; the player reads it through a server route, never as a raw config value.
RADIO_STREAM_URL=<set in Vercel>

# Optional server-only Naija Radio catalogue key for Guts FM (not Radio Lagos).
# Set NAIJA_RADIO_API_KEY securely in Vercel for the relevant environment.
NAIJA_RADIO_API_KEY=<set in Vercel>

# ── Newsletter delivery (server only) ───────────────────────────────────────
# Candidate newsletter intake is disabled until delivery, abuse, privacy,
# retention and end-to-end checks are complete.
# NEWSLETTER_SIGNUP_ENABLED=true
NEWSLETTER_SMTP_HOST=<smtp host — set in Vercel>
NEWSLETTER_SMTP_PORT=<smtp port — set in Vercel>
NEWSLETTER_SMTP_USER=<smtp user — set in Vercel>
NEWSLETTER_SMTP_PASSWORD=<never — set in Vercel>
NEWSLETTER_SMTP_SECURE=<true for implicit TLS — set in Vercel>
# FORM_RATE_SECRET=<random-secret-at-least-32-bytes — set in Vercel>

# ── Private enquiry intake (server only) ────────────────────────────────────
# Leave off until the staff RPC migration, monitored inbox, retention policy
# and complete delivery/security testing are ready.
# ENQUIRY_INTAKE_ENABLED=true

# ── Admin origin ────────────────────────────────────────────────────────────
# Server-only origin used for admin links/redirects. Set in Vercel.
ADMIN_ORIGIN=<set in Vercel>

# ── Indexing ────────────────────────────────────────────────────────────────
# Override the indexing gate: "true" forces indexing on, "false" forces it off.
# Unset → indexable only when NEXT_PUBLIC_SITE_URL resolves to a production host.
ALLOW_INDEXING=

# ── Cron ────────────────────────────────────────────────────────────────────
# Protects scheduled jobs (stream status checks, etc.). Server only.
CRON_SECRET=<never — set in Vercel>

# ── Maintenance ─────────────────────────────────────────────────────────────
# Enable only after the maintenance migration is safely applied and verified.
MAINTENANCE_GATE_ENABLED=false
