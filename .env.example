 # EPE LAWA — environment variables
# Copy this file to .env.local (development) and set the real values in Vercel (production).
# Never commit real values. Names marked **never** must never reach a client bundle.

# ── Site origin ─────────────────────────────────────────────────────────────
# Canonical origin of the platform. Used for metadataBase, canonical URLs, sitemap,
# Open Graph and CORS. Fallback in code: https://epelawa.vercel.app
NEXT_PUBLIC_SITE_URL=https://epelawa.vercel.app

# News and staff use this same origin at /news and /admin; no separate host variables are needed.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public: safe to ship to the browser. RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://igqmybuiovaxqmrteebd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<never — set in Vercel>

# Server only. Never in a client bundle, a log or a test fixture.
SUPABASE_SERVICE_ROLE_KEY=<never — set in Vercel>

# ── Cloudflare R2 (object storage) ──────────────────────────────────────────
# Media rows store provider + bucket + object_key, never a full URL.
R2_BUCKET_PUBLIC=<set in Vercel>
R2_BUCKET_PRIVATE=<set in Vercel>
R2_ACCOUNT_ID=<set in Vercel>

# ── Custom Auth email (server only) ─────────────────────────────────────────
# Server only.
RESEND_API_KEY=<never — set in Vercel>
# Custom Supabase Auth email hook, server-only. Do not enable the hook until
# the deployed route, sender domain, secret and end-to-end delivery are verified.
# Gmail takes precedence if both Gmail values are set. If neither is set,
# Resend is used when its key is configured. Partial Gmail config fails closed.
AUTH_GMAIL_USER=<Gmail account — set in Vercel>
AUTH_GMAIL_APP_PASSWORD=<Gmail app password — set in Vercel, never in chat>
# Optional defaults: Gmail only, 465 implicit TLS or 587 required STARTTLS.
AUTH_GMAIL_SMTP_HOST=smtp.gmail.com
AUTH_GMAIL_SMTP_PORT=465
AUTH_EMAIL_FROM=<approved sender for selected provider — set in Vercel>
AUTH_EMAIL_HOOK_SECRET=<whsec_ followed by base64 of 32 random bytes; match Supabase — set in Vercel>

# ── Paystack (payments, NGN) ────────────────────────────────────────────────
# Secret key and webhook secret: server only, never in a client bundle.
PAYSTACK_SECRET_KEY=<never — set in Vercel>
PAYSTACK_WEBHOOK_SECRET=<never — set in Vercel>

# Public key: safe for the client (Paystack inline checkout initialisation).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<set in Vercel>

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Public key shipped to the client; private key stays on the server.
VAPID_PUBLIC_KEY=<set in Vercel>
VAPID_PRIVATE_KEY=<never — set in Vercel>

# ── Radio ───────────────────────────────────────────────────────────────────
# Verified direct stream URL for Radio Lagos 107.5 FM (Naija Radio API catalogue).
# Server only; the player reads it through a server route, never as a raw config value.
RADIO_STREAM_URL=<set in Vercel>

# ── Indexing ────────────────────────────────────────────────────────────────
# Override the indexing gate: "true" forces indexing on, "false" forces it off.
# Unset → indexable only when NEXT_PUBLIC_SITE_URL resolves to a production host.
ALLOW_INDEXING=

# ── Cron ────────────────────────────────────────────────────────────────────
# Protects scheduled jobs (stream status checks, etc.). Server only.
CRON_SECRET=<never — set in Vercel>

# Candidate newsletter intake is disabled until delivery, abuse, privacy,
# retention and end-to-end checks are complete. Server-side only.
# NEWSLETTER_SIGNUP_ENABLED=true
# FORM_RATE_SECRET=<random-secret-at-least-32-bytes>
# SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Private enquiry intake: leave off until the staff RPC migration, monitored
# inbox, retention policy and complete delivery/security testing are ready.
# ENQUIRY_INTAKE_ENABLED=true
