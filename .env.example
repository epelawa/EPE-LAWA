# EPE LAWA — environment variables that are safe to expose to the browser.
# Copy to `.env` for local work. Never put a secret in a file that starts with NEXT_PUBLIC_.

# Public origin of the platform, used for canonical URLs, Open Graph, the sitemap, robots
# and the CORS allow-origin header. Falls back to https://epelawa.ng when unset.
NEXT_PUBLIC_SITE_URL=

# Public origin of the news publication host, for example the news subdomain.
# When unset, "News" renders as plain text instead of a link, because there is no destination.
NEXT_PUBLIC_NEWS_URL=

# Optional explicit override for search engine indexing, "true" or "false".
# Unset means: index only when NEXT_PUBLIC_SITE_URL resolves to the production host.
ALLOW_INDEXING=
